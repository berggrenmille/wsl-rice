    "terminal.ansiBlue": "#9E7BFF",
    "terminal.ansiCyan": "#62D6E8",
    "terminal.ansiWhite": "#B7AAC8",
    "terminal.ansiBrightBlack": "#766286",
    "terminal.ansiBrightRed": "#FF8FAF",
    "terminal.ansiBrightGreen": "#A1F1C6",
    "terminal.ansiBrightYellow": "#F1D29D",
    "terminal.ansiBrightBlue": "#BEA6FF",
    "terminal.ansiBrightCyan": "#9AEAF3",
    "terminal.ansiBrightWhite": "#F2EBFA",
    "terminal.ansiMagenta": "#B56CFF",
    "terminal.ansiBrightMagenta": "#E06CDB"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9080A5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#B56CFF"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#9080A5"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#7BD9AD"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#D6B477"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#62D6E8"
      }
    },
    {
      "name": "Types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#E06CDB"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#DDD5E8"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#DDD5E8"
      }
    },
    {
      "name": "Language variables",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#B56CFF"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#9080A5"
      }
    },
    {
      "name": "String delimiters",
      "scope": [
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#7BD9AD"
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#E06CDB"
      }
    },
    {
      "name": "Interpolation",
      "scope": [
        "punctuation.section.embedded",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#E06CDB"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#B56CFF"
      }
    },
    {
      "name": "Attributes and keys",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name.json",
        "string.json support.type.property-name"
      ],
      "settings": {
        "foreground": "#62D6E8"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#E06CDB"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator"
      ],
      "settings": {
        "foreground": "#E06CDB"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#B56CFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#62D6E8"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#7BD9AD"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#E06CDB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#DDD5E8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Diff added",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#7BD9AD"
      }
    },
    {
      "name": "Diff removed",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#F2779A"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#F2779A"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#E06CDB",
    "type": "#E06CDB",
    "class": "#E06CDB",
    "struct": "#E06CDB",
    "interface": "#E06CDB",
    "enum": "#E06CDB",
    "typeParameter": "#E06CDB",
    "function": "#62D6E8",
    "method": "#62D6E8",
    "variable": "#DDD5E8",
    "parameter": "#DDD5E8",
    "property": "#DDD5E8",
    "enumMember": "#D6B477",
    "variable.readonly": "#D6B477",
    "property.readonly": "#D6B477",
    "number": "#D6B477",
    "macro": "#E06CDB",
    "decorator": "#E06CDB",
    "keyword": "#B56CFF",
    "string": "#7BD9AD",
    "operator": "#9080A5"
  }
}
